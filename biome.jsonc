{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "javascript": {
    // "Bun": apps/copiloto-runtime/src/server.ts (Fase 3) is the first
    // package in this repo that runs as a standalone Bun process
    // instead of through Next.js/Vercel — every other app/package only
    // uses Bun as the package manager/test runner, never the `Bun.*`
    // runtime global.
    "globals": ["Liveblocks", "Bun"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!packages/collaboration/config.ts",
      "!docs",
      "!apps/docs/**/*.json",
      "!apps/email/.react-email",
      "!packages/cms/basehub-types.d.ts",
      "!packages/mapa-os/templates"
    ]
  },
  "overrides": [
    {
      // M17-T04: packages/typescript-config's shared tsconfig presets
      // are consumed via `extends`, not the literal filename
      // `tsconfig.json` Biome recognizes as JSONC by default — so their
      // real, useful comments (documenting why a compiler option is set)
      // were failing strict JSON parsing repo-wide, a pre-existing gap
      // this milestone's CI lint gate surfaced (found while wiring
      // ci.yml, unrelated to any of this milestone's own code changes).
      "includes": ["packages/typescript-config/*.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ]
}
