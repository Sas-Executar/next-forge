{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // chart.stories.tsx and resizable.stories.tsx exercise the two generated
  // shadcn components excluded in packages/design-system/tsconfig.json (see
  // that file for why) — excluded here for the same reason.
  "exclude": ["node_modules", "stories/chart.stories.tsx", "stories/resizable.stories.tsx"]
}
