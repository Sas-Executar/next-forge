{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "public/scroll-task-prototype/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/execution-assets/(styles\\.css|app\\.mjs|model\\.mjs)",
      "dest": "/public/scroll-task-prototype/$1"
    },
    {
      "src": "/(tarefas|foco|configuracoes)/?",
      "dest": "/public/scroll-task-prototype/index.html"
    },
    {
      "src": "/",
      "dest": "/public/scroll-task-prototype/index.html"
    },
    {
      "src": "/scroll-task-prototype/?",
      "dest": "/public/scroll-task-prototype/index.html"
    }
  ]
}
