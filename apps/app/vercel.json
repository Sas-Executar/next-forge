{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "public/scroll-task-prototype/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/scroll-task-prototype/index.html"
    },
    {
      "src": "/scroll-task-prototype/?",
      "dest": "/public/scroll-task-prototype/index.html"
    }
  ]
}
